{
  "name": "brass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/cloud-report.mjs smoke",
    "test:regression": "node scripts/cloud-report.mjs regression",
    "test:benchmark": "node scripts/cloud-report.mjs benchmark",
    "report:cloud": "node -e \"console.log('see reports/cloud/*-latest.json')\"",
    "era1:baseline": "vitest run src/era1-baseline-report.test.ts --testTimeout=600000",
    "era1:anchor": "vitest run src/ai/era1Anchor.test.ts --testTimeout=300000",
    "era1:compare": "vitest run src/ai/era1Anchor-compare.test.ts --testTimeout=600000",
    "era1:outside": "vitest run src/ai/era1Anchor-outside.test.ts --testTimeout=900000",
    "era2:anchor": "vitest run src/ai/finalAnchor.test.ts --testTimeout=300000"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
